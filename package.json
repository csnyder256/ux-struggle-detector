{
  "name": "clarus-heal",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "sdk:build": "esbuild src/sdk/script-entry.ts --bundle --format=iife --global-name=ClarusHeal --outfile=public/sdk.js --target=es2020 --legal-comments=none",
    "sdk:build:min": "esbuild src/sdk/script-entry.ts --bundle --format=iife --global-name=ClarusHeal --outfile=public/sdk.min.js --target=es2020 --minify --legal-comments=none",
    "test": "vitest run",
    "test:watch": "vitest",
    "sdk:package": "node scripts/build-sdk-package.mjs",
    "demo:build": "esbuild src/demo/product-demo.ts --bundle --format=iife --outfile=public/demo/demo.js --target=es2020 --minify --legal-comments=none",
    "sdk:verify": "node scripts/verify-sdk-consumer.mjs",
    "demo:verify": "node scripts/verify-sdk-demo.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.8",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "^15.5.27",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.0.16",
    "openai": "^7.30.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.5.27",
    "jsdom": "30.1.2",
    "postcss": "^8.5.29",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
